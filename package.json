{
  "name": "oclr-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run archive:relations:check && npm run write-api:check",
    "test:e2e": "playwright test",
    "test:components": "playwright test --config playwright.components.config.ts",
    "perf:collections": "node --import tsx scripts/collection-baseline.ts",
    "perf:api": "node --import tsx scripts/api-baseline.ts",
    "perf:workers": "node --import tsx scripts/worker-baseline.ts",
    "test:referee:acceptance": "node --import tsx scripts/referee-acceptance.ts",
    "test": "vitest run",
    "i18n:extract": "node --import tsx scripts/i18n.ts",
    "test:i18n": "vitest run tests/unit/i18n.test.ts",
    "read-api:generate": "node --import tsx scripts/generate-extended-contracts.ts && node --import tsx scripts/read-api-spec.ts && node --import tsx scripts/generate-remote-matrix.ts",
    "read-api:check": "node --import tsx scripts/generate-extended-contracts.ts --check && node --import tsx scripts/generate-remote-matrix.ts --check && vitest run tests/unit/read-api.test.ts tests/unit/read-api-dx.test.ts",
    "write-api:generate": "node --import tsx scripts/write-api-spec.ts",
    "write-api:check": "npm run write-api:generate -- --check",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:local": "tsx scripts/local-database.ts",
    "db:seed:dev": "tsx scripts/seed-development.ts",
    "test:integration": "vitest run tests/integration",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "release:check": "tsx scripts/check-release.ts",
    "db:import-editions": "tsx scripts/import-editions.ts",
    "db:backfill-archive-reads": "tsx scripts/backfill-archive-reads.ts",
    "db:normalize-archives": "tsx scripts/normalize-archives.ts",
    "archive:relations:generate": "node --import tsx scripts/generate-archive-relations.ts",
    "archive:relations:check": "node --import tsx scripts/generate-archive-relations.ts --check",
    "db:correct-s2-pool": "tsx scripts/correct-s2-pool.ts",
    "db:backfill-statistics": "tsx scripts/backfill-statistics.ts",
    "production:setup": "bash scripts/production.sh setup",
    "production:start": "bash scripts/production.sh start",
    "production:update": "bash scripts/update.sh",
    "production:cleanup": "bash scripts/cleanup-releases.sh",
    "media:cleanup": "tsx scripts/cleanup-media.ts",
    "test:e2e:remote": "playwright test --config playwright.remote.config.ts",
    "test:e2e:functional": "playwright test --config playwright.functional.config.ts",
    "test:e2e:core": "playwright test --config playwright.core.config.ts",
    "test:e2e:header": "playwright test --config playwright.header.config.ts",
    "test:e2e:remote:core": "playwright test --config playwright.remote-core.config.ts",
    "prepare": "node --import tsx scripts/build-appearance-styles.ts",
    "predev": "node --import tsx scripts/build-appearance-styles.ts",
    "prebuild": "node --import tsx scripts/build-appearance-styles.ts",
    "db:refresh-player-leaderboard": "tsx scripts/refresh-player-leaderboard.ts",
    "db:refresh-beatmap-difficulties": "tsx scripts/refresh-beatmap-difficulties.ts"
  },
  "dependencies": {
    "@cm3tahkuh/react-tournament-brackets": "^1.1.6",
    "@fullcalendar/react": "7.1.3",
    "@next/env": "16.4.2",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-svg-pan-zoom": "^3.13.1",
    "sharp": "^0.35.5",
    "styled-components": "^6.6.0",
    "temporal-polyfill": "1.0.1",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
