[Unit]
Description=OCLR S11 Skill Issue rating synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=oclr
Group=oclr
WorkingDirectory=/opt/oclr/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/oclr/runtime.env
EnvironmentFile=/etc/oclr/sip-ratings.env
ExecStart=/usr/bin/node --import tsx /opt/oclr/current/scripts/refresh-sip-ratings.ts --apply
TimeoutStartSec=1h
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
