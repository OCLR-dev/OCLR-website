[Unit]
Description=Refresh OCLR S11 Elitebotix ratings
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=oclr
Group=oclr
WorkingDirectory=/opt/oclr/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/oclr/runtime.env
ExecStart=/usr/bin/node --import tsx /opt/oclr/current/scripts/refresh-etx-ratings.ts --apply
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
