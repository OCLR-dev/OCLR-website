{
  "openapi": "3.1.0",
  "info": {
    "title": "OCLR browser write API",
    "version": "0.1.0",
    "description": "Incremental documentation of existing OCLR browser routes. See write-api-inventory.json for coverage."
  },
  "components": {
    "securitySchemes": {
      "browserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-oclr_session"
      },
      "localBrowserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "oclr_session",
        "description": "Session cookie when plain HTTP is allowed locally."
      }
    },
    "schemas": {
      "WorkspaceWriteError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/tournaments/{edition}/player/availability": {
      "post": {
        "operationId": "writePlayerAvailability",
        "summary": "Save the signed-in player's own season availability",
        "description": "Each interval must end after it starts. Overlaps between different availability states are rejected. An omitted status means available. Requires an accepted registration or captain appointment in a published, non-archived edition with a writable player workspace. Send the last observed version as expectedVersion, or 0 for the first write. Reuse requestKey only when retrying the same payload after an uncertain outcome.",
        "security": [
          {
            "browserSession": []
          },
          {
            "localBrowserSession": []
          }
        ],
        "parameters": [
          {
            "name": "edition",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must match the configured site origin.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "x-max-body-bytes": 32768,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "const": "save_availability"
                  },
                  "intervals": {
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "start": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        },
                        "end": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "available",
                            "unsure",
                            "unavailable"
                          ]
                        }
                      },
                      "required": [
                        "start",
                        "end"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "requestKey": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "required": [
                  "action",
                  "intervals",
                  "expectedVersion",
                  "requestKey"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved version, including for a successful retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saved": {
                      "type": "boolean",
                      "const": true
                    },
                    "version": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "saved",
                    "version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Missing, malformed, or invalid JSON command.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "401": {
            "description": "An authenticated browser session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "403": {
            "description": "Origin, authentication channel, or eligibility rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "404": {
            "description": "The workspace is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "409": {
            "description": "Read-only workspace, stale data, or a reused request key with a different payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "413": {
            "description": "The JSON body exceeds the byte limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "503": {
            "description": "Site origin configuration is unavailable or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          }
        }
      }
    },
    "/api/tournaments/{edition}/player/practice": {
      "post": {
        "operationId": "writePlayerPractice",
        "summary": "Save or delete the signed-in player's own practice record",
        "description": "The mappool entry must be published. expectedContext must match the current chart and mod policy. Deletion returns the same versioned receipt as a save. Requires an accepted registration or captain appointment in a published, non-archived edition with a writable player workspace. Send the last observed version as expectedVersion, or 0 for the first write. Reuse requestKey only when retrying the same payload after an uncertain outcome.",
        "security": [
          {
            "browserSession": []
          },
          {
            "localBrowserSession": []
          }
        ],
        "parameters": [
          {
            "name": "edition",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Origin",
            "in": "header",
            "required": true,
            "description": "Must match the configured site origin.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "x-max-body-bytes": 32768,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "score": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "feel": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "bad",
                              "normal",
                              "good"
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "comment": {
                        "type": "string",
                        "description": "After trimming surrounding whitespace, the comment may contain up to 2000 UTF-16 code units."
                      },
                      "entryId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "expectedContext": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "expectedVersion": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "requestKey": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "action": {
                        "type": "string",
                        "const": "save_practice"
                      }
                    },
                    "required": [
                      "score",
                      "comment",
                      "entryId",
                      "expectedContext",
                      "expectedVersion",
                      "requestKey",
                      "action"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "entryId": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "expectedContext": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      },
                      "expectedVersion": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "requestKey": {
                        "type": "string",
                        "format": "uuid",
                        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                      },
                      "action": {
                        "type": "string",
                        "const": "delete_practice"
                      }
                    },
                    "required": [
                      "entryId",
                      "expectedContext",
                      "expectedVersion",
                      "requestKey",
                      "action"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The saved version, including for a successful retry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saved": {
                      "type": "boolean",
                      "const": true
                    },
                    "version": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "saved",
                    "version"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Missing, malformed, or invalid JSON command.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "401": {
            "description": "An authenticated browser session is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "403": {
            "description": "Origin, authentication channel, or eligibility rejected.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "404": {
            "description": "The workspace, published mappool entry, or record is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "409": {
            "description": "Read-only workspace, stale data, or a reused request key with a different payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "413": {
            "description": "The JSON body exceeds the byte limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          },
          "503": {
            "description": "Site origin configuration is unavailable or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceWriteError"
                }
              }
            }
          }
        }
      }
    }
  }
}
